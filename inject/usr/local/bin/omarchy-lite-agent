#!/usr/bin/env bash
# Omarchy Lite Agent - guided setup + repair for old x86-64 machines (<2 GB RAM).
# Uses gum when available (ships with Omarchy), falls back to plain shell menus.
set -uo pipefail

AGENT_NAME="Omarchy Lite Agent"
CONFIG_DIR="${HOME:-/root}/.config/hypr"
STATE_DIR="${HOME:-/root}/.local/state/omarchy-lite"
mkdir -p "$CONFIG_DIR" "$STATE_DIR"

note() { printf '\n\033[1;36m%s\033[0m\n' "$*"; }
warn() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }

say() {
  if command -v gum >/dev/null 2>&1; then
    gum style --border rounded --border-foreground 39 --padding "1 2" --margin "1 0" "$1"
  else
    printf '\n== %s ==\n' "$1"
  fi
}

confirm() {
  if command -v gum >/dev/null 2>&1; then
    gum confirm "$1"
  else
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy] ]]
  fi
}

choose() {
  local header="$1"; shift
  if command -v gum >/dev/null 2>&1; then
    gum choose --header "$header" "$@"
  else
    local i=1 item
    printf '\n%s\n' "$header"
    for item in "$@"; do printf '  %d) %s\n' "$i" "$item"; i=$((i+1)); done
    local n
    read -r -p "Choose [1-$((i-1))]: " n
    [[ "$n" =~ ^[0-9]+$ ]] && [[ "$n" -ge 1 ]] && [[ "$n" -le "$((i-1))" ]] || return 1
    printf '%s\n' "${!#}" >/dev/null # no-op keeps shellcheck quiet
    eval "printf '%s\\n' \"\${$n}\""
  fi
}

# ---------------------------------------------------------------------------
apply_lowram() {
  say "Applying low-RAM graphics profile"
  if command -v omarchy-lite-lowram >/dev/null 2>&1; then
    omarchy-lite-lowram
  else
    warn "omarchy-lite-lowram not found - applying inline profile"
    cat > "$CONFIG_DIR/looknfeel.lua" <<'EOF'
-- Omarchy Lite: low-RAM graphics profile.
-- Animations are the single biggest CPU/GPU cost in Hyprland on old hardware.
hl.config({
  animations = { enabled = false },
  decoration = {
    blur = { enabled = false },
    shadow = { enabled = false },
  },
  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
})
EOF
    cat > "$CONFIG_DIR/monitors.lua" <<'EOF'
-- Omarchy Lite: scale 1 keeps framebuffers small on <2 GB RAM machines.
local omarchy_monitor_scale = 1
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })
hl.env("GDK_SCALE", "1")
EOF
  fi
  # Reduce GPU/CPU work for Qt apps too.
  mkdir -p "${HOME:-/root}/.config/environment.d"
  cat > "${HOME:-/root}/.config/environment.d/omarchy-lite.conf" <<'EOF'
GDK_SCALE=1
QT_QPA_PLATFORMTHEME=gtk3
EOF
  note "Done. Reload Hyprland with  SUPER + CTRL + RETURN  (or log out/in)."
  confirm "Reload Hyprland now?" && {
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload
  }
}

# ---------------------------------------------------------------------------
fix_display() {
  say "Display information"
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl monitors all 2>&1 | head -60
  elif command -v xrandr >/dev/null 2>&1; then
    xrandr --query 2>&1 | head -60
  else
    warn "No hyprctl or xrandr found. Are you inside a graphical session?"
  fi

  if confirm "Try a safe 1024x768@60 display mode?"; then
    if command -v hyprctl >/dev/null 2>&1; then
      hyprctl keyword monitor "-,1024x768@60,auto,1" 2>&1 || warn "hyprctl could not set the mode."
    elif command -v xrandr >/dev/null 2>&1; then
      xrandr --output "$(xrandr --query | awk '/ connected/{print $1; exit}')" \
        --mode 1024x768 --rate 60 2>&1 || warn "xrandr could not set the mode."
    fi
  fi
}

# ---------------------------------------------------------------------------
network_check() {
  say "Network check"
  ip -br address show 2>/dev/null | head -20 || ifconfig -a 2>/dev/null | head -40
  note "Pinging 1.1.1.1 ..."
  ping -c 2 -W 2 1.1.1.1 2>&1 | tail -5
  note "If there is no network, run:  sudo iwctl  (WiFi) or check your cable."
}

# ---------------------------------------------------------------------------
launch_opencode() {
  say "OpenCode AI coding agent (bundled, baseline build for old CPUs)"
  if command -v opencode >/dev/null 2>&1; then
    note "Starting OpenCode. Type /help for commands, /exit to leave."
    exec opencode
  fi
  # The bundled binary lives in /usr/local/bin. Fall back to it explicitly in
  # case PATH was trimmed by a desktop session; no network is ever used.
  if [[ -x /usr/local/bin/opencode ]]; then
    note "Starting bundled OpenCode from /usr/local/bin/opencode."
    exec /usr/local/bin/opencode
  fi
  warn "The bundled OpenCode binary is missing from this image."
  return 0
}

safe_graphics() {
  say "Safe Graphics Mode (offline)"
  warn "This forces llvmpipe software rendering and restarts the display manager."
  confirm "Continue?" || return 0
  if command -v omarchy-lite-safe-mode >/dev/null 2>&1; then
    omarchy-lite-safe-mode
  else
    warn "omarchy-lite-safe-mode not found. Reboot and try again."
  fi
}

fix_colors() {
  say "Fix dark/washed-out colors (old GPU)"
  local f="$CONFIG_DIR/looknfeel.lua"
  if grep -q 'cm_enabled' "$f" 2>/dev/null; then
    note "Color-management fix is already present."
  else
    cat >>"$f" <<'EOF'

-- Omarchy Lite: correct colors on old GLES 3.0 GPUs.
-- Hyprland's color-management shader needs GLSL ES 3.20, which these GPUs
-- do not provide. Disabling it avoids the broken dark/washed-out fallback.
hl.config({ render = { cm_enabled = false } })
EOF
    note "Added the color fix to $f"
  fi
  confirm "Reload Hyprland now?" && {
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload
  }
}

# ---------------------------------------------------------------------------
system_info() {
  say "System information"
  if command -v fastfetch >/dev/null 2>&1; then
    fastfetch
  elif command -v inxi >/dev/null 2>&1; then
    inxi -Fz
  else
    grep -E '^(model name|MemTotal)' /proc/cpuinfo /proc/meminfo 2>/dev/null | head -10
  fi
  note "Memory in use:"
  free -h
}

# ---------------------------------------------------------------------------
open_terminal() {
  for t in foot kitty alacritty xfce4-terminal xterm; do
    if command -v "$t" >/dev/null 2>&1; then "$t" & return 0; fi
  done
  warn "No terminal emulator found. Try Super + Return from the Omarchy launcher."
}

# ---------------------------------------------------------------------------
main() {
  while true; do
    local choice
    choice=$(choose "$AGENT_NAME - what do you need?" \
      "Apply low-RAM graphics profile" \
      "Repair legacy GPU (offline Safe Graphics Mode)" \
      "Fix dark/washed-out colors (old GPU)" \
      "Fix display / resolution" \
      "Check network" \
      "System information" \
      "Launch OpenCode AI agent" \
      "Open a terminal" \
      "Exit") || return 0

    case "$choice" in
      "Apply low-RAM graphics profile") apply_lowram ;;
      "Repair legacy GPU (offline Safe Graphics Mode)") safe_graphics ;;
      "Fix dark/washed-out colors (old GPU)") fix_colors ;;
      "Fix display / resolution")       fix_display ;;
      "Check network")                  network_check ;;
      "System information")             system_info ;;
      "Launch OpenCode AI agent")       launch_opencode ;;
      "Open a terminal")                open_terminal ;;
      *) return 0 ;;
    esac
    command -v gum >/dev/null 2>&1 && gum style --foreground 244 "Press Enter to continue..." >/dev/null && read -r
  done
}

main "$@"
